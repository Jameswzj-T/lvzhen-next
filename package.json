{
  "name": "lvzhen-next",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "^22.23.1 || ^24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.20.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3107",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3107",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format:check": "prettier --check src next.config.ts package.json tsconfig.json",
    "export:public": "node scripts/export-public.mjs"
  },
  "dependencies": {
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "better-auth": "1.7.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "nodemailer": "^10.0.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "prettier": "3.9.6",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "^4.0.0"
  }
}
