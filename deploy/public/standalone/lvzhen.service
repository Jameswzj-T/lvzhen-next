[Unit]
Description=Lvzhen public learning app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lvzhen
Group=lvzhen
WorkingDirectory=/opt/lvzhen/current
EnvironmentFile=/etc/lvzhen/public.env
ExecStart=/opt/lvzhen/runtime/bin/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/cache/lvzhen
UMask=0077

[Install]
WantedBy=multi-user.target
